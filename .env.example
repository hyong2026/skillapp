# SkillApp Web configuration

# Optional Basic Auth / Bearer token. Leave empty for loopback-only access.
SKILLAPP_WEB_TOKEN=

# Optional content root. Defaults to <repo>/.data.
# SKILLAPP_DATA_DIR=

# Local analyzer used by Analyze.
SKILLAPP_ANALYZE_COMMAND=codex
SKILLAPP_ANALYZE_MODEL=deepseek-v4.1-flash
SKILLAPP_ANALYZE_REASONING_EFFORT=high
SKILLAPP_ANALYZE_TIMEOUT_MS=900000

# Optional JSON argument array. When set, it replaces the default codex arguments.
# SKILLAPP_ANALYZE_ARGS=[]

# Run 时同一批同时跑几行（默认 4，上限 8）。
# 直接改这一行要重启服务；`PUT /api/settings` 改则下一个 Run 即时生效。
# SKILLAPP_RUN_CONCURRENCY=4

# 列表每页条数（默认 10，上限 200）。服务端每次请求读一次，改完下次翻页就生效。
# SKILLAPP_PAGE_SIZE=10

# 通用生图（.agents/skills/image-generator）：所有 Skill 共用，见 docs/cli.md。
# 必填三行：OpenAI 兼容端点 + 密钥 + 模型（模型可用 --model 临时覆盖）
# SKILLAPP_IMAGE_BASE_URL=https://api.example.com/v1
# SKILLAPP_IMAGE_API_KEY=sk-...
# SKILLAPP_IMAGE_MODEL=gpt-image-2.5-flare
# 可选：SKILLAPP_IMAGE_SIZE / _QUALITY / _TIMEOUT_MS / _OPENAI_CLI（见 image-generator/SKILL.md）
