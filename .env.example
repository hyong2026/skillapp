# SkillApp Web configuration

# Optional Basic Auth / Bearer token. Leave empty for loopback-only access.
SKILLAPP_WEB_TOKEN=

# Optional content root. Defaults to <repo>/.data.
# SKILLAPP_DATA_DIR=

# Local analyzer used by Analyze.
SKILLAPP_ANALYZE_COMMAND=codex
SKILLAPP_ANALYZE_MODEL=deepseek/deepseek-v4.1-flash
SKILLAPP_ANALYZE_REASONING_EFFORT=low
SKILLAPP_ANALYZE_TIMEOUT_MS=900000

# Optional JSON argument array. When set, it replaces the default codex arguments.
# SKILLAPP_ANALYZE_ARGS=[]

# Run 时同一批同时跑几行（默认 4，上限 8）。
# 直接改这一行要重启服务；`PUT /api/settings` 改则下一个 Run 即时生效。
# SKILLAPP_RUN_CONCURRENCY=4
